# Required OpenAI-compatible provider settings.
RAGAGENT_CHAT_MODEL=
RAGAGENT_CHAT_BASE_URL=
RAGAGENT_CHAT_API_KEY=
RAGAGENT_EMBEDDING_MODEL=
RAGAGENT_EMBEDDING_BASE_URL=
RAGAGENT_EMBEDDING_API_KEY=

# Runtime defaults.
RAGAGENT_REQUEST_TIMEOUT_SEC=30
RAGAGENT_TOP_K=5
RAGAGENT_TRACE_JSONL_PATH=

# PostgreSQL / pgvector deployment and integration tests.
RAGAGENT_PGVECTOR_DSN=
RAGAGENT_PGVECTOR_TEST_DSN=

# Opt-in live validation. Keep disabled in normal unit/race test runs.
RAGAGENT_INTEGRATION_LIVE=0
